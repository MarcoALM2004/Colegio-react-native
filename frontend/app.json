{
  "expo": {
    "name": "my-app-colegio",
    "slug": "my-app-colegio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "EduConnect necesita acceder a tu cámara para tomar y enviar fotografías.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EduConnect necesita acceder a tu cámara para tomar y enviar fotografías por mensajes.",
          "photosPermission": "EduConnect necesita acceder a tus fotografías para compartir imágenes."
        }
      ],
      "expo-font"
    ]
  }
}
